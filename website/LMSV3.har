          "cookies": [],
          "content": {
            "size": 1978,
            "mimeType": "application/json",
            "text": "{\"id\":196,\"type\":\"sub-section\",\"title\":\"Quiz\",\"item_type\":\"QUIZ\",\"sort_order\":6,\"builder_fields\":[{\"id\":659,\"type\":\"multiple\",\"content\":\"Jika teman-teman ingin menginvestigasi apakah fitur MaxHR (angka kontinu) memiliki rentang perbedaan nilai yang tajam antara kelompok pasien HeartDisease = 0 dan HeartDisease = 1, alat visual dan fungsi Pandas manakah yang paling pas?\",\"points\":35,\"sort_order\":1,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":307,\"label\":\"A. sns.boxplot()\",\"is_correct\":true,\"sort_order\":1},{\"id\":308,\"label\":\"B. sns.scatterplot()\",\"is_correct\":false,\"sort_order\":2},{\"id\":309,\"label\":\"C. df.groupby('HeartDisease')['MaxHR'].mean()\",\"is_correct\":true,\"sort_order\":3},{\"id\":310,\"label\":\"D. df.corr()\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":660,\"type\":\"single\",\"content\":\"Saat mengeksekusi df.corr() pada dataset Heart Failure kita, skor korelasi antara MaxHR dan HeartDisease berada di angka sekitar -0,28. Analisis logis apa yang bisa ditarik?\",\"points\":35,\"sort_order\":2,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":311,\"label\":\"A. Tidak terbentuk pola yang jelas antara MaxHR dengan HeartDisease.\",\"is_correct\":false,\"sort_order\":1},{\"id\":312,\"label\":\"B. Makin tinggi MaxHR pasien, makin besar kemungkinan ia terdiagnosis HeartDisease.\",\"is_correct\":false,\"sort_order\":2},{\"id\":313,\"label\":\"C. Makin rendah MaxHR pasien, makin besar kecenderungan ia terdiagnosis HeartDisease.\",\"is_correct\":true,\"sort_order\":3},{\"id\":314,\"label\":\"D. Terdapat anomali komputasi karena koefisien korelasi mustahil bernilai negatif.\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":661,\"type\":\"shorttext\",\"content\":\"Parameter argumen apa pada fungsi sns.heatmap() yang harus diset True agar sistem mencetak angka-angka korelasinya di atas matriks warna? (huruf kecil semua)\",\"points\":30,\"sort_order\":3,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":\"annot\",\"options\":[]}],\"configuration\":null}"
          },
