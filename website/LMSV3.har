              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=z6VRs%2Fmdn4Mf5Q8dkyc5x%2BhMhAz%2FbdXkxBNFvvqvgfIHVgQE3AgX2%2F4JxJOeVQgPJu1cu9a3Wzv4AxcP%2Bhgqh9fHigXanGMEx5t2e4XfZiNLHTA5srt4y%2FWpaC6xGqrcLRNBmWc%3D\"}]}"
