          "content": {
            "size": 1908,
            "mimeType": "application/json",
            "text": "{\"id\":189,\"type\":\"sub-section\",\"title\":\"7. Practice Quiz\",\"item_type\":\"QUIZ\",\"sort_order\":7,\"builder_fields\":[{\"id\":642,\"type\":\"single\",\"content\":\"Pernyataan manakah yang paling tepat mendeskripsikan tujuan utama analisis univariate?\",\"points\":35,\"sort_order\":1,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":299,\"label\":\"A. Menemukan korelasi statistik antara tekanan darah pasien dengan target.\",\"is_correct\":false,\"sort_order\":1},{\"id\":300,\"label\":\"B. Memprediksi label target masa depan menggunakan algoritma Machine Learning yang canggih.\",\"is_correct\":false,\"sort_order\":2},{\"id\":301,\"label\":\"C. Meringkas dan memetakan pola distribusi dari satu variabel saja secara independen untuk memahami karakteristik datanya.\",\"is_correct\":true,\"sort_order\":3},{\"id\":302,\"label\":\"D. Menggabungkan beberapa dataset terpisah menjadi satu tabel master (Data Merging).\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":643,\"type\":\"multiple\",\"content\":\"Jika teman-teman menganalisis kolom Usia_Pelanggan yang murni berisi angka, fungsi\\/metode apa yang paling relevan untuk fase Univariate Analysis?\",\"points\":35,\"sort_order\":2,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":303,\"label\":\"A. df['Usia_Pelanggan'].describe()\",\"is_correct\":true,\"sort_order\":1},{\"id\":304,\"label\":\"B. sns.countplot(x='Usia_Pelanggan')\",\"is_correct\":false,\"sort_order\":2},{\"id\":305,\"label\":\"C. df['Usia_Pelanggan'].isna()\",\"is_correct\":false,\"sort_order\":3},{\"id\":306,\"label\":\"D. sns.histplot(x='Usia_Pelanggan')\",\"is_correct\":true,\"sort_order\":4}]},{\"id\":644,\"type\":\"shorttext\",\"content\":\"Library Python mana yang dibangun di atas matplotlib, dan kita gunakan untuk memanggil fungsi seperti histplot() dan countplot()? \\n\\n(huruf kecil semua)\",\"points\":30,\"sort_order\":3,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":\"seaborn\",\"options\":[]}],\"configuration\":null}"
          },
