              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=gdCoMz9lsOkR9UwZ26orzY3C7CJEI4aXVFWnFhtwPdbgFKqIqamgxnBLz91bBJ8eBFOuwz08JR2V5ZvpYTpsUoPbz%2BiS2RJ%2BL2J6hcObgjdj%2Fmqhfly44tqooovtwaKjiGHP3vs%3D\"}]}"
            },
