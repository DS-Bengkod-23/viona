          "cookies": [],
          "content": {
            "size": 3930,
            "mimeType": "application/json",
            "text": "{\"id\":209,\"type\":\"sub-section\",\"title\":\"Kuis\",\"item_type\":\"QUIZ\",\"sort_order\":7,\"builder_fields\":[{\"id\":719,\"type\":\"multiple\",\"content\":\"Apa konsekuensi paling logis ketika kamu langsung menjalankan training model Machine Learning menggunakan dataset yang masih berisi banyak missing values (NaN)?\",\"points\":20,\"sort_order\":1,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":435,\"label\":\"A. Model akan bekerja lambat, tapi lama-kelamaan bisa memahaminya.\",\"is_correct\":false,\"sort_order\":1},{\"id\":436,\"label\":\"B. Proses training akan crash atau menampilkan error karena algoritma matematis tidak bisa mengkalkulasi NaN.\",\"is_correct\":true,\"sort_order\":2},{\"id\":437,\"label\":\"C. Model akan memperbaiki nilai NaN tersebut secara otomatis di belakang layar.\",\"is_correct\":false,\"sort_order\":3},{\"id\":438,\"label\":\"D. Model tetap akan belajar tetapi menghasilkan akurasi yang rendah\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":720,\"type\":\"single\",\"content\":\"Manakah pernyataan yang paling tepat menjelaskan EDA (Exploratory Data Analysis)?\",\"points\":20,\"sort_order\":2,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":439,\"label\":\"A. EDA adalah proses membuat grafik presentasi di akhir proyek agar terlihat menarik.\",\"is_correct\":false,\"sort_order\":1},{\"id\":440,\"label\":\"B. EDA adalah proses konfirmatori yang menguji hipotesis yang sudah ditentukan sejak awal.\",\"is_correct\":false,\"sort_order\":2},{\"id\":441,\"label\":\"C. EDA adalah proses eksplorasi data menggunakan statistik ringkas dan visualisasi sebelum data dipakai untuk modeling.\",\"is_correct\":true,\"sort_order\":3},{\"id\":442,\"label\":\"D. EDA adalah nama lain untuk algoritma Machine Learning yang dipakai untuk klasifikasi.\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":721,\"type\":\"single\",\"content\":\"Saat berada di Langkah ke-2 pipeline EDA (High-level Overview), fungsi mana yang paling cepat dan tepat untuk memeriksa tipe data seluruh kolom serta jumlah memory yang digunakan DataFrame?\",\"points\":20,\"sort_order\":3,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":443,\"label\":\"A. df.describe()\",\"is_correct\":false,\"sort_order\":1},{\"id\":444,\"label\":\"B. df.tail()\",\"is_correct\":false,\"sort_order\":2},{\"id\":445,\"label\":\"C. df.info()\",\"is_correct\":true,\"sort_order\":3},{\"id\":446,\"label\":\"D. df.shape\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":722,\"type\":\"single\",\"content\":\"Manakah kombinasi fungsi dari library Pandas yang digunakan untuk menghitung total akumulasi nilai kosong (missing values) untuk masing-masing kolom pada sebuah DataFrame?\",\"points\":20,\"sort_order\":4,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":447,\"label\":\"A. df.isnull().count()\",\"is_correct\":false,\"sort_order\":1},{\"id\":448,\"label\":\"B. df.isnull().sum()\",\"is_correct\":true,\"sort_order\":2},{\"id\":449,\"label\":\"C. df.isna().any()\",\"is_correct\":false,\"sort_order\":3},{\"id\":450,\"label\":\"D. df.count().sum()\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":723,\"type\":\"single\",\"content\":\"Mengapa Exploratory Data Analysis (EDA) sangat penting dilakukan sebelum membangun model machine learning atau melakukan pemodelan statistik?\",\"points\":20,\"sort_order\":5,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":451,\"label\":\"A. Untuk memastikan model machine learning memiliki akurasi 100% tanpa perlu melakukan tuning.\",\"is_correct\":false,\"sort_order\":1},{\"id\":452,\"label\":\"B. Untuk mempercepat durasi waktu training pada komputer server secara otomatis.\",\"is_correct\":false,\"sort_order\":2},{\"id\":453,\"label\":\"C. Untuk memahami karakteristik data, mendeteksi outlier, serta mengidentifikasi pola dan hubungan tersembunyi dalam dataset.\",\"is_correct\":true,\"sort_order\":3},{\"id\":454,\"label\":\"D. Untuk secara otomatis menghapus semua kolom yang memiliki nilai kosong tanpa pengecekan lebih lanjut.\",\"is_correct\":false,\"sort_order\":4}]}],\"configuration\":null}"
          },
