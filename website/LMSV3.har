              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=nKloRCQGYMe4aZPX9lIHVC61eQi0eJICK3CUtwdT3prWoEUXZcuxh0EOAXnRnC71FXVoIMSvEkybrMgHFC0%2Bq5X9kB26Cmn9r5pl9QUmbI4TXkEzQsX8LdBAXUUgRN5fgsW1JUg%3D\"}]}"
