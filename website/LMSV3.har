              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=wpEQhGEBXfNwGgIncDwMNF6iUFdXzFEX5ezSX4VdJ39Pp6P1FKmjzqZ5Ypt%2Br%2BBf9cU9XCoOnwcM9aW7VmMlweLnYoT4YckdMphO6F6e5oTKbKQ1c0KbS7zTICV6IxGy%2BuWDGPw%3D\"}]}"
