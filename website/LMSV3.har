          "content": {
            "size": 2069,
            "mimeType": "application/json",
            "text": "{\"id\":70,\"type\":\"sub-section\",\"title\":\"Quiz\",\"item_type\":\"QUIZ\",\"sort_order\":6,\"builder_fields\":[{\"id\":163,\"type\":\"single\",\"content\":\"Apa tujuan utama dilakukannya proses Exploratory Data Analysis (EDA)?\",\"points\":25,\"sort_order\":1,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":59,\"label\":\"Menulis algoritma Machine Learning yang rumit untuk memprediksi masa depan.\",\"is_correct\":true,\"sort_order\":1},{\"id\":60,\"label\":\"Menyelidiki data mentah untuk menemukan pola, anomali, dan memverifikasi asumsi sebelum tahap modeling.\",\"is_correct\":false,\"sort_order\":2},{\"id\":61,\"label\":\"Menyimpan dataset yang berukuran besar ke dalam basis data (database).\",\"is_correct\":false,\"sort_order\":3},{\"id\":62,\"label\":\"Mengubah dataset tabular menjadi format gambar dan video.\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":164,\"type\":\"single\",\"content\":\"Jika seorang *Data Scientist* mengabaikan proses EDA dan langsung melatih model menggunakan data yang mengandung banyak *missing values* dan data yang salah ukuran, prinsip apa yang paling menggambarkan situasi ini?\",\"points\":25,\"sort_order\":2,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":63,\"label\":\"Simple but Not Simpler\",\"is_correct\":false,\"sort_order\":1},{\"id\":64,\"label\":\"Feature Engineering\",\"is_correct\":false,\"sort_order\":2},{\"id\":65,\"label\":\"Garbage In, Garbage Out\",\"is_correct\":true,\"sort_order\":3},{\"id\":66,\"label\":\"Unsupervised Learning\",\"is_correct\":false,\"sort_order\":4}]},{\"id\":165,\"type\":\"multiple\",\"content\":\"Pilih *library* Python di bawah ini yang akan sering kita gunakan untuk memanipulasi dan memvisualisasikan data selama kursus berlangsung! (Pilih lebih dari satu)\",\"points\":50,\"sort_order\":3,\"is_required\":true,\"is_locked\":false,\"correct_answer_text\":null,\"options\":[{\"id\":67,\"label\":\"Pandas\",\"is_correct\":true,\"sort_order\":1},{\"id\":68,\"label\":\"Matplotlib\",\"is_correct\":true,\"sort_order\":2},{\"id\":69,\"label\":\"Flask\",\"is_correct\":false,\"sort_order\":3},{\"id\":70,\"label\":\"Seaborn\",\"is_correct\":true,\"sort_order\":4}]}],\"configuration\":null}"
