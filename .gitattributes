# Force LF line endings for files that run inside Linux containers
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env*      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf

# Binary files — no conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.mp3       binary
*.mp4       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.onnx      binary
*.pt        binary
*.pkl       binary
