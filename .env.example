# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cartesia TTS ────────────────────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238

# ─── VoxCPM2 TTS (Local, Voice Cloning) ───────────────────────────────────────
VOXCPM2_ENABLED=true
VOXCPM2_MODEL_NAME=openbmb/VoxCPM2
VOXCPM2_DEVICE=cuda
# Path ke audio referensi untuk voice cloning (hasil dari scripts/prepare_voice.py)
# VOXCPM2_REFERENCE_AUDIO=assets/voice_reference_processed.wav
# Transcript audio referensi (opsional, untuk Ultimate Cloning mode — fidelitas terbaik)
# VOXCPM2_REFERENCE_TRANSCRIPT=

# ─── Ollama LLM ───────────────────────────────────────────────────────────────
# PENTING: Jangan tambahkan /v1 di sini — backend menggunakan native Ollama API
# (/api/generate, /api/embed), bukan OpenAI-compat endpoint.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=ollama

# ─── Embedding (via Ollama) ───────────────────────────────────────────────────
EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_DIM=1024  # Biasanya auto-detect; uncomment untuk override eksplisit

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=viona_faq

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL=3600

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+62xxxxxxxxxx
TWILIO_SIP_TRUNK_SID=TKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Faster-Whisper STT ───────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=large-v3
WHISPER_LANGUAGE=id
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
