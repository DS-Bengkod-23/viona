# Salin ke .env.local untuk development lokal (npm run dev)
#
# Kosongkan NEXT_PUBLIC_API_URL jika frontend diakses lewat nginx (docker compose)
# pada http://localhost — request API akan same-origin lewat proxy nginx.
#
# Isi URL backend jika menjalankan frontend dan API terpisah:
NEXT_PUBLIC_API_URL=http://localhost:8000
