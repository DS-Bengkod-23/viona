# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cartesia TTS ─────────────────────────────────────────────────────────────
CARTESIA_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_VOICE_ID=a167e0f3-df7e-4d52-a9c3-f949145efdab
CARTESIA_MODEL=sonic-multilingual

# ─── Ollama LLM ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=ollama

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=viona_faq

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL=3600

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+62xxxxxxxxxx
TWILIO_SIP_TRUNK_SID=TKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Faster-Whisper STT ───────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=large-v3
WHISPER_LANGUAGE=id
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
